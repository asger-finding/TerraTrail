[sub_resource type="GDScript" id="GDScript_rrmtm"]
script/source = "extends Control

@onready var username_input: LineEdit = %UsernameInput
@onready var password_input: LineEdit = %PasswordInput
@onready var submit_button: Button = %SubmitSignupButton
@onready var terms_checkbox: TextureRect = %TermsCheckbox

var _terms_accepted: bool = false

func _on_submit_signup_button_button_up() -> void:
	var username := username_input.text.strip_edges()
	var password := password_input.text

	if username.is_empty() or password.is_empty():
		push_warning(\"Username og password er påkrævet\")
		return

	if password.length() < 8:
		push_warning(\"Password skal være mindst 8 tegn\")
		return

	if not _terms_accepted:
		push_warning(\"Du skal acceptere vilkårene\")
		return

	submit_button.disabled = true
	var result: Dictionary = await Backend.signup(username, password)
	submit_button.disabled = false

	if not result[\"ok\"]:
		push_warning(\"Signup fejl: %s\" % result[\"error\"])
		return

	PlayerState.set_from_response(result[\"data\"])
	Router.goto(\"waypoints\")

func _on_terms_row_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and not event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		_terms_accepted = not _terms_accepted
		terms_checkbox.texture = preload(\"res://assets/ui/checkbox_active.png\") if _terms_accepted else preload(\"res://assets/ui/checkbox.png\")

func _on_back_button_button_up() -> void:
	Router.back()
"

