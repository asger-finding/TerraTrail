[gd_scene format=3 uid="uid://bd6sa0uwarw6u"]

[sub_resource type="GDScript" id="GDScript_1jerj"]
script/source = "extends Control

@onready var username_input: LineEdit = %UsernameInput
@onready var password_input: LineEdit = %PasswordInput
@onready var submit_button: Button = %SubmitLoginButton

func _on_submit_login_button_button_up() -> void:
	var username := username_input.text.strip_edges()
	var password := password_input.text

	if username.is_empty() or password.is_empty():
		push_warning(\"Username og password er påkrævet\")
		return

	submit_button.disabled = true
	var result: Dictionary = await Backend.login(username, password)
	submit_button.disabled = false

	if not result[\"ok\"]:
		push_warning(\"Login fejl: %s\" % result[\"error\"])
		return

	PlayerState.set_from_response(result[\"data\"])
	Router.goto(\"main\")

func _on_back_button_button_up() -> void:
	Router.back()

func _on_back_button_pressed() -> void:
	Router.back()
"

